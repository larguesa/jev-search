# Deny by default. New public files must be deliberately allowlisted.
/*
!/.gitignore
!/.gitattributes
!/pyproject.toml
!/MANIFEST.in
!/LICENSE
!/README.md
!/agents.md
!/jev_search.py
!/tests/
/tests/*
!/tests/__init__.py
!/tests/__main__.py
!/tests/benchmark.py
!/tests/test_search.py
!/tests/test_release.py
!/tests/test_windows.py
!/tests/test_evolution.py
!/tests/test_ranking.py
!/tests/ranking_benchmark.py
!/tests/RANKING_REPORT.md
!/tests/RANKING_DEPTH_REPORT.md
!/tests/REPORT.md
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/synthetic.txt
!/tests/fixtures/intents.json
!/tests/fixtures/benchmark-summary.json
!/tests/fixtures/ranking.json
!/tests/fixtures/ranking-results.json
!/skills/
/skills/*
!/skills/jev-search/
/skills/jev-search/*
!/skills/jev-search/SKILL.md
!/docs/
/docs/*
!/docs/install.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml

# Private originals, credentials and local/generated artifacts remain local.
**/AGENTS.md
**/.env*
**/__pycache__/
**/*.pyc
/evidence/
/docs/status.md
/private-release-backup/
/build/
/dist/
/*.egg-info/
